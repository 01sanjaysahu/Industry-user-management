<%- include('partials/head', { title }) %><%- include('partials/nav') %>
<main class="page-shell"><div class="page-heading"><div><div class="eyebrow">YOUR WORKSPACE</div><h1>Good to see you, <%= currentUser.name.split(' ')[0] %>.</h1><p class="muted">Here is your account overview.</p></div><span class="status-pill status-active">● Account active</span></div>
<div class="welcome-card"><div><div class="eyebrow">PERSONAL OVERVIEW</div><h2>Your workspace is ready.</h2><p>You're signed in securely. Your account details and access are managed here.</p></div><div class="welcome-symbol">N</div></div>
<div class="section-heading"><div><h2>Account details</h2><p class="muted">Your current profile information</p></div></div><div class="detail-grid"><article class="detail-card"><span class="detail-label">FULL NAME</span><strong><%= currentUser.name %></strong></article><article class="detail-card"><span class="detail-label">EMAIL ADDRESS</span><strong><%= currentUser.email %></strong></article><article class="detail-card"><span class="detail-label">ACCESS ROLE</span><strong class="capitalize"><%= currentUser.role %></strong></article><article class="detail-card"><span class="detail-label">ACCOUNT STATUS</span><strong><span class="status-pill status-active">Active</span></strong></article></div>
<% if (currentUser.role === 'admin') { %><a class="button button-primary" href="/admin">Open admin portal →</a><% } %></main><%- include('partials/foot') %>
