<header class="topbar"><a class="brand" href="/"><span class="brand-mark">N</span><span>northstar<span class="brand-light"> / portal</span></span></a>
  <% if (currentUser) { %><nav class="nav-links"><% if (currentUser.role === 'admin') { %><a href="/admin">Overview</a><a href="/admin/users">User management</a><% } else { %><a href="/dashboard">Dashboard</a><% } %></nav><div class="nav-user"><span class="avatar"><%= currentUser.name.charAt(0).toUpperCase() %></span><span class="nav-name"><%= currentUser.name %><small><%= currentUser.role %></small></span><form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" type="submit">Sign out</button></form></div><% } else { %><nav class="nav-links"><a href="/login">Sign in</a><a class="button button-primary button-small" href="/register">Create account</a></nav><% } %>
</header>
