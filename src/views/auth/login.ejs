<%- include('../partials/head', { title }) %><%- include('../partials/nav') %>
<main class="auth-wrap"><section class="auth-aside"><div class="eyebrow">NORTHSTAR WORKSPACE</div><h1>One clear view.<br><span>Better work.</span></h1><p>A secure, focused workspace to manage people, roles and everyday operations.</p><div class="aside-points"><div><span class="point-icon">✓</span> Secure account access</div><div><span class="point-icon">✓</span> Role-based permissions</div><div><span class="point-icon">✓</span> Simple team management</div></div><div class="aside-orbit"></div></section>
<section class="auth-panel"><div class="form-card"><div class="eyebrow">WELCOME BACK</div><h2>Sign in to your account</h2><p class="muted">Enter your details to continue to your workspace.</p>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %><% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
<form method="POST" action="/login" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email address<input type="email" name="email" value="<%= values.email || '' %>" placeholder="you@company.com" autocomplete="email" maxlength="120" required></label><label>Password<input type="password" name="password" placeholder="Enter your password" autocomplete="current-password" required></label><button class="button button-primary button-wide" type="submit">Sign in <span>→</span></button></form><p class="form-bottom">New to Northstar? <a href="/register">Create an account</a></p></div><div class="auth-note">Your workspace is protected with encrypted password storage and secure sessions.</div></section></main>
<%- include('../partials/foot') %>
