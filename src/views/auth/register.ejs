<%- include('../partials/head', { title }) %><%- include('../partials/nav') %>
<main class="auth-wrap"><section class="auth-aside"><div class="eyebrow">GET STARTED</div><h1>Make room<br>for <span>good work.</span></h1><p>Create your account and get a clean, organized view of your work.</p><div class="aside-points"><div><span class="point-icon">✓</span> One place for your profile</div><div><span class="point-icon">✓</span> Clear account status</div><div><span class="point-icon">✓</span> Access that fits your role</div></div><div class="aside-orbit"></div></section>
<section class="auth-panel"><div class="form-card"><div class="eyebrow">CREATE YOUR PROFILE</div><h2>Start with the basics</h2><p class="muted">Your account will be created with standard user access.</p><% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<form method="POST" action="/register" class="stack-form" data-validate><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Full name<input type="text" name="name" value="<%= values.name || '' %>" placeholder="Your name" minlength="2" maxlength="70" autocomplete="name" required></label><label>Work email<input type="email" name="email" value="<%= values.email || '' %>" placeholder="you@company.com" maxlength="120" autocomplete="email" required></label><label>Password<input type="password" name="password" id="password" placeholder="At least 8 characters" minlength="8" maxlength="72" autocomplete="new-password" required><small class="field-hint">Use at least 8 characters.</small></label><label>Confirm password<input type="password" name="confirmPassword" placeholder="Enter password again" minlength="8" maxlength="72" autocomplete="new-password" required></label><button class="button button-primary button-wide" type="submit">Create account <span>→</span></button></form><p class="form-bottom">Already registered? <a href="/login">Sign in</a></p></div></section></main>
<%- include('../partials/foot') %>
