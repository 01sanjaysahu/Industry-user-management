<%- include('../partials/head', { title }) %><%- include('../partials/nav') %>
<main class="page-shell"><div class="page-heading"><div><div class="eyebrow">ADMINISTRATION / PEOPLE</div><h1>User management</h1><p class="muted">Create accounts, update access and keep your directory current.</p></div><button class="button button-primary" type="button" data-open-modal="create-modal">＋ Add user</button></div>
<% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
<section class="content-card"><div class="toolbar"><div><h2>All users</h2><p class="muted"><%= users.length %> result(s) · Maximum 200 shown</p></div><form class="search-form" method="GET" action="/admin/users"><input type="search" name="search" value="<%= search %>" placeholder="Search name or email"><button class="button button-secondary button-small" type="submit">Search</button><% if (search) { %><a class="clear-link" href="/admin/users">Clear</a><% } %></form></div>
<div class="table-wrap"><table><thead><tr><th>USER</th><th>ROLE</th><th>STATUS</th><th>LAST SIGN IN</th><th class="align-right">ACTIONS</th></tr></thead><tbody><% if (!users.length) { %><tr><td colspan="5" class="empty-state">No matching users found.</td></tr><% } %><% users.forEach(user => { %><tr><td><div class="person-cell"><span class="avatar avatar-table"><%= user.name.charAt(0).toUpperCase() %></span><span><strong><%= user.name %></strong><small><%= user.email %></small></span></div></td><td><span class="role-tag"><%= user.role %></span></td><td><span class="status-pill <%= user.status === 'active' ? 'status-active' : 'status-inactive' %>"><%= user.status %></span></td><td><%= user.lastLoginAt ? user.lastLoginAt.toLocaleDateString() : 'Never' %></td><td class="align-right"><button class="button button-quiet button-small" type="button" data-edit-user data-id="<%= user._id %>" data-name="<%= user.name %>" data-email="<%= user.email %>" data-role="<%= user.role %>" data-status="<%= user.status %>">Edit</button><% if (user._id.toString() !== currentUser._id.toString()) { %><form class="inline-form" method="POST" action="/admin/users/<%= user._id %>/delete" data-confirm="Delete <%= user.name %>? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-quiet button-small" type="submit">Delete</button></form><% } else { %><span class="you-label">You</span><% } %></td></tr><% }) %></tbody></table></div></section>
</main>
<div class="modal-backdrop" id="create-modal" aria-hidden="true"><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="create-title"><div class="modal-heading"><div><div class="eyebrow">NEW ACCOUNT</div><h2 id="create-title">Add a user</h2></div><button class="icon-button" type="button" data-close-modal aria-label="Close">×</button></div><form method="POST" action="/admin/users" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Full name<input name="name" required minlength="2" maxlength="70" placeholder="Full name"></label><label>Email address<input name="email" type="email" required maxlength="120" placeholder="name@company.com"></label><label>Temporary password<input name="password" type="password" required minlength="8" maxlength="72" placeholder="At least 8 characters"></label><label>Role<select name="role"><option value="user">User</option><option value="admin">Administrator</option></select></label><div class="modal-actions"><button class="button button-secondary" type="button" data-close-modal>Cancel</button><button class="button button-primary" type="submit">Create user</button></div></form></section></div>
<div class="modal-backdrop" id="edit-modal" aria-hidden="true"><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-title"><div class="modal-heading"><div><div class="eyebrow">ACCOUNT SETTINGS</div><h2 id="edit-title">Edit user</h2></div><button class="icon-button" type="button" data-close-modal aria-label="Close">×</button></div><form method="POST" id="edit-user-form" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Full name<input name="name" id="edit-name" required minlength="2" maxlength="70"></label><label>Email address<input name="email" id="edit-email" type="email" required maxlength="120"></label><label>New password <span class="muted inline-muted">(leave blank to keep current)</span><input name="password" type="password" minlength="8" maxlength="72" placeholder="Optional new password"></label><div class="form-row"><label>Role<select name="role" id="edit-role"><option value="user">User</option><option value="admin">Administrator</option></select></label><label>Status<select name="status" id="edit-status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label></div><div class="modal-actions"><button class="button button-secondary" type="button" data-close-modal>Cancel</button><button class="button button-primary" type="submit">Save changes</button></div></form></section></div>
<%- include('../partials/foot') %>
