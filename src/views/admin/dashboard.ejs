<%- include('../partials/head', { title }) %><%- include('../partials/nav') %>
<main class="page-shell"><div class="page-heading"><div><div class="eyebrow">ADMINISTRATION / OVERVIEW</div><h1>Workspace overview</h1><p class="muted">A live snapshot of accounts and access across your workspace.</p></div><a class="button button-primary" href="/admin/users">Manage users <span>→</span></a></div>
<div class="stats-grid"><article class="stat-card"><div class="stat-top"><span>Total users</span><span class="stat-icon">◎</span></div><strong><%= stats.totalUsers %></strong><small>All registered accounts</small></article><article class="stat-card"><div class="stat-top"><span>Active users</span><span class="stat-icon icon-green">✓</span></div><strong><%= stats.activeUsers %></strong><small>Accounts with access</small></article><article class="stat-card"><div class="stat-top"><span>Inactive users</span><span class="stat-icon icon-amber">Ⅱ</span></div><strong><%= stats.inactiveUsers %></strong><small>Access currently paused</small></article><article class="stat-card"><div class="stat-top"><span>Administrators</span><span class="stat-icon icon-purple">♙</span></div><strong><%= stats.adminUsers %></strong><small>Privileged accounts</small></article></div>
<section class="content-card"><div class="section-heading"><div><h2>Recently added users</h2><p class="muted">The latest accounts created in your workspace.</p></div><a class="text-link" href="/admin/users">View all users →</a></div><div class="table-wrap"><table><thead><tr><th>USER</th><th>ROLE</th><th>STATUS</th><th>JOINED</th></tr></thead><tbody><% if (!recentUsers.length) { %><tr><td colspan="4" class="empty-state">No users have registered yet.</td></tr><% } %><% recentUsers.forEach(user => { %><tr><td><div class="person-cell"><span class="avatar avatar-table"><%= user.name.charAt(0).toUpperCase() %></span><span><strong><%= user.name %></strong><small><%= user.email %></small></span></div></td><td><span class="role-tag"><%= user.role %></span></td><td><span class="status-pill <%= user.status === 'active' ? 'status-active' : 'status-inactive' %>"><%= user.status %></span></td><td><%= user.createdAt.toLocaleDateString() %></td></tr><% }) %></tbody></table></div></section>
</main><%- include('../partials/foot') %>
